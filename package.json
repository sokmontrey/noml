{
    "name": "noml",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*",
        "packages/plugins/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace @noml/web",
        "build": "tsc --noEmit -p apps/web/tsconfig.json && npm run build --workspace @noml/web",
        "preview": "npm run preview --workspace @noml/web",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint apps packages tests",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dexie": "^4.4.7",
        "effect": "^4.1.4",
        "fractional-indexing": "^4.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "fake-indexeddb": "^6.2.4",
        "oxlint": "^1.94.0",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "~7.0.2",
        "vite": "^8.3.8",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^3.2.4"
    }
}
